@host = http://127.0.0.1:8080
@baseUrl = {{host}}/api/v1/sandbox-game

@adminRole = ADMIN
@adminUserId = 1
@adminUsername = admin

@groupRole = GROUP
@groupUserId = 101
@groupUsername = group01
@groupId = 1

@yearNo = 0
@adjustmentId = 1
@knownRevision = 0

### 管理员：查看通知与奖罚记录
GET {{baseUrl}}/admin-notice/get-records?limit=20
X-Role-Type: {{adminRole}}
X-User-Id: {{adminUserId}}
X-Username: {{adminUsername}}

### 管理员：发送全体普通通知
POST {{baseUrl}}/admin-notice/send-general
Content-Type: application/json
X-Role-Type: {{adminRole}}
X-User-Id: {{adminUserId}}
X-Username: {{adminUsername}}

{
  "targetScope": "ALL",
  "content": "比赛进度提醒：请各组尽快完成本阶段经营与财报提交。",
  "pinned": true
}

### 管理员：预览下发奖励
### 服务端按目标组当前状态自动返回 resolvedStageCode，不接收 stageCode
POST {{baseUrl}}/admin-notice/preview-adjustment
Content-Type: application/json
X-Role-Type: {{adminRole}}
X-User-Id: {{adminUserId}}
X-Username: {{adminUsername}}

{
  "operation": "CREATE",
  "groupId": {{groupId}},
  "yearNo": {{yearNo}},
  "adjustmentType": "REWARD",
  "amount": 88,
  "reason": "现场经营表现奖励"
}

### 管理员：正式下发奖励
### 正式执行会按最新草稿和状态再次权威重算
POST {{baseUrl}}/admin-notice/send-adjustment
Content-Type: application/json
X-Role-Type: {{adminRole}}
X-User-Id: {{adminUserId}}
X-Username: {{adminUsername}}

{
  "groupId": {{groupId}},
  "yearNo": {{yearNo}},
  "adjustmentType": "REWARD",
  "amount": 88,
  "reason": "现场经营表现奖励"
}

### 玩家：检查奖罚 revision
### knownRevision 与服务端一致时返回 notModified=true
GET {{baseUrl}}/player-notice/get-adjustment-sync?yearNo={{yearNo}}&knownRevision={{knownRevision}}
X-Role-Type: {{groupRole}}
X-User-Id: {{groupUserId}}
X-Username: {{groupUsername}}
X-Group-Id: {{groupId}}

### 管理员：预览作废奖罚
POST {{baseUrl}}/admin-notice/preview-adjustment
Content-Type: application/json
X-Role-Type: {{adminRole}}
X-User-Id: {{adminUserId}}
X-Username: {{adminUsername}}

{
  "operation": "VOID",
  "adjustmentId": {{adjustmentId}}
}

### 管理员：正式作废奖罚
### 仅可作废未破产小组、可编辑年份中的有效奖罚
POST {{baseUrl}}/admin-notice/void-adjustment
Content-Type: application/json
X-Role-Type: {{adminRole}}
X-User-Id: {{adminUserId}}
X-Username: {{adminUsername}}

{
  "adjustmentId": {{adjustmentId}},
  "reason": "管理员确认原奖罚录入有误"
}

### 管理员：预览高额罚款的破产风险
### 若 willBankrupt=true，只在演练库继续执行正式下发
POST {{baseUrl}}/admin-notice/preview-adjustment
Content-Type: application/json
X-Role-Type: {{adminRole}}
X-User-Id: {{adminUserId}}
X-Username: {{adminUsername}}

{
  "operation": "CREATE",
  "groupId": {{groupId}},
  "yearNo": {{yearNo}},
  "adjustmentType": "PENALTY",
  "amount": 1000,
  "reason": "破产风险联调样例"
}
